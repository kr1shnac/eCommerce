{
  "name": "kunigal-grocery",
  "version": "0.1.0",
  "private": true,
  "description": "Grocery & essentials delivery app for Kunigal, Karnataka — mobile app, shop admin panel and Supabase database.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace @kunigal/mobile",
    "mobile:android": "npm run android --workspace @kunigal/mobile",
    "mobile:ios": "npm run ios --workspace @kunigal/mobile",
    "mobile:web": "npm run web --workspace @kunigal/mobile",
    "admin": "npm run dev --workspace @kunigal/admin",
    "dev": "concurrently --names \"mobile,admin\" --prefix-colors \"green,cyan\" \"npm:mobile\" \"npm:admin\"",
    "test:db": "./supabase/tests/run.sh",
    "check:session": "node --import ./scripts/node-hooks/register.mjs ./scripts/check-session-persistence.mjs",
    "check:auth-doors": "node --import ./scripts/node-hooks/register.mjs ./scripts/check-auth-doors.mjs",
    "check:view": "node --import ./scripts/node-hooks/register.mjs ./scripts/check-order-view.mjs",
    "check:persist": "node --import ./scripts/node-hooks/register.mjs ./scripts/check-query-persistence.mjs",
    "check:speech": "node --import ./scripts/node-hooks/register.mjs ./scripts/check-speech.mjs",
    "check:packs": "node --import ./scripts/node-hooks/register.mjs ./scripts/check-packs.mjs",
    "check:storage": "node --import ./scripts/node-hooks/register.mjs ./scripts/check-storage.mjs",
    "check:tracking": "node --import ./scripts/node-hooks/register.mjs ./scripts/check-tracking.mjs",
    "lint": "npm run lint --workspaces --if-present && npm run check:i18n && npm run check:view && npm run check:persist && npm run check:speech && npm run check:packs && npm run check:auth-doors && npm run check:storage && npm run check:tracking",
    "check:i18n": "node scripts/check-i18n.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
