    "whatWeCollectBody": "ನಿಮ್ಮ ಫೋನ್ ಸಂಖ್ಯೆ, ಡೆಲಿವರಿಗೆ ಕೊಡುವ ಹೆಸರು ಮತ್ತು ವಿಳಾಸ, ಮತ್ತು ನೀವು ಆರ್ಡರ್ ಮಾಡುವ ಸಾಮಾನು. ನೋಟಿಸ್ ಆನ್ ಮಾಡಿದರೆ, ಆರ್ಡರ್ ಬಗ್ಗೆ ಫೋನ್ ಮಾಡಲು ಬೇಕಾದ ಟೋಕನ್ ಕೂಡ ಇಡುತ್ತೇವೆ. ಅಷ್ಟೇ.",
    "whyTitle": "ಇದು ಏಕೆ ಬೇಕು",
    "whyBody": "ಫೋನ್ ಸಂಖ್ಯೆಯಿಂದಲೇ ಸೈನ್ ಇನ್ ಆಗುತ್ತದೆ, ಮತ್ತು ಡೆಲಿವರಿ ಹುಡುಗ ಅಥವಾ ಅಂಗಡಿ ನಿಮ್ಮನ್ನು ಸಂಪರ್ಕಿಸುತ್ತದೆ. ನಿಮ್ಮ ವಿಳಾಸ ಎಂದರೆ ಚೀಲ ಹೋಗುವ ಜಾಗ. ಹಿಂದಿನ ಆರ್ಡರ್‌ಗಳಿಂದ ನೀವು ಏನು ತಗೊಂಡಿದ್ದೀರಿ ಎಂದು ತೋರಿಸುತ್ತೇವೆ, ಅಂಗಡಿಯ ಲೆಕ್ಕವೂ ಅದರಿಂದ ನಡೆಯುತ್ತದೆ.",
    "whoSeesTitle": "ಇದನ್ನು ಯಾರು ನೋಡುತ್ತಾರೆ",
    "whoSeesBody": "ಅಂಗಡಿ ಮತ್ತು ನಿಮ್ಮ ಆರ್ಡರ್ ಒಯ್ಯುವ ಡೆಲಿವರಿ ಹುಡುಗ. ಆರ್ಡರ್ ದಾರಿಯಲ್ಲಿರುವಾಗ ಮಾತ್ರ ಅವನಿಗೆ ನಿಮ್ಮ ವಿಳಾಸ ಕಾಣುತ್ತದೆ. ನಿಮ್ಮ ಮಾಹಿತಿಯನ್ನು ಯಾರಿಗೂ ಮಾರುವುದಿಲ್ಲ, ಈ ಆಪ್‌ನಲ್ಲಿ ಜಾಹೀರಾತು ಇಲ್ಲ.",
    "consentTitle": "ನಿಮ್ಮ ಒಪ್ಪಿಗೆ",
    "consentBody": "ಸೈನ್ ಇನ್ ಮಾಡಿ ಆರ್ಡರ್ ಮಾಡುವುದೇ ನಿಮ್ಮ ಒಪ್ಪಿಗೆ. ಯಾವಾಗ ಬೇಕಾದರೂ ಖಾತೆ ಅಳಿಸಿ ಅದನ್ನು ಹಿಂಪಡೆಯಬಹುದು. ಈ ಮಾಹಿತಿ ಇಂಗ್ಲಿಷ್ ಮತ್ತು ಕನ್ನಡ ಎರಡರಲ್ಲೂ ಇದೆ — ಈಗ ಓದುತ್ತಿರುವ ಭಾಷೆಯಲ್ಲೇ, ಮತ್ತು ಖಾತೆ ಪುಟದಲ್ಲಿ ಯಾವಾಗ ಬೇಕಾದರೂ ಭಾಷೆ ಬದಲಿಸಬಹುದು.",
    "keepTitle": "ಎಷ್ಟು ಕಾಲ ಇಡುತ್ತೇವೆ",
    "keepBody": "ಖಾತೆ ಇರುವವರೆಗೆ ನಿಮ್ಮ ಹೆಸರು, ಫೋನ್ ಸಂಖ್ಯೆ ಮತ್ತು ವಿಳಾಸ ಇರುತ್ತದೆ. ಖಾತೆ ಅಳಿಸಿದರೆ ಅವು ಅಳಿಸಿಹೋಗುತ್ತವೆ. ಆದರೆ ಹಿಂದಿನ ಆರ್ಡರ್‌ಗಳ ಬರಿ ದಾಖಲೆ — ಆರ್ಡರ್ ಸಂಖ್ಯೆ, ಸಾಮಾನು ಮತ್ತು ಮೊತ್ತ — ಉಳಿಯುತ್ತದೆ, ಏಕೆಂದರೆ ಅಂಗಡಿ ತನ್ನ ಮಾರಾಟ ತೋರಿಸಬೇಕು. ಅಳಿಸಿದ ಮೇಲೆ ಆ ದಾಖಲೆಗಳಲ್ಲಿ ನೀವು ಯಾರು ಎಂದು ಇರುವುದಿಲ್ಲ.",
    "rightsTitle": "ನಿಮ್ಮ ಹಕ್ಕುಗಳು",
    "rightsBody": "ನಮ್ಮ ಬಳಿ ಏನಿದೆ ಎಂದು ನೋಡಬಹುದು, ತಪ್ಪಿದ್ದರೆ ಸರಿಪಡಿಸಲು ಹೇಳಬಹುದು, ಅಳಿಸಲು ಹೇಳಬಹುದು. ಅಳಿಸುವ ಬಟನ್ ಖಾತೆ ಪುಟದಲ್ಲಿ, 'ಖಾತೆ ಅಳಿಸಿ' ಕೆಳಗೆ ಇದೆ — ಒತ್ತಿದ ಕೂಡಲೇ ಆಗುತ್ತದೆ. ಬೇರೆ ಏನಾದರೂ ಬೇಕಿದ್ದರೆ ಅಂಗಡಿಗೆ ಫೋನ್ ಮಾಡಿ.",
    "termsTitle": "ಈ ಆಪ್ ಬಳಸುವ ಬಗ್ಗೆ",
    "termsBody": "ಇಲ್ಲಿ ಕಾಣುವ ಬೆಲೆ ಮತ್ತು ಸಾಮಾನು ಅಂಗಡಿಯದ್ದು, ಬದಲಾಗಬಹುದು. ಆರ್ಡರ್ ಮಾಡುವಾಗ ಒಪ್ಪಿಕೊಂಡ ಬೆಲೆಯೇ ನಿಮಗೆ ಅನ್ವಯ. ಡೆಲಿವರಿ ಹುಡುಗ ಬಂದಾಗ ನಗದು ಕೊಡುತ್ತೀರಿ. ಆಗದ ಆರ್ಡರ್ ಅನ್ನು ಅಂಗಡಿ ತಿರಸ್ಕರಿಸಬಹುದು, ಮತ್ತು ಏಕೆ ಎಂದು ಹೇಳುತ್ತದೆ. ಅಂಗಡಿ ಡೆಲಿವರಿ ಮಾಡುವ ಪಿನ್ ಕೋಡ್‌ಗಳಿಗೆ ಮಾತ್ರ ಡೆಲಿವರಿ — ಅವು ಮುಂದುವರಿಸುವಾಗ ಕಾಣುತ್ತವೆ.",
    "questionsTitle": "ಪ್ರಶ್ನೆ ಇದೆಯೇ",
    "questionsBody": "ಅಂಗಡಿಗೆ ಫೋನ್ ಮಾಡಿ. ಆ ಕಡೆ ಒಬ್ಬ ನಿಜವಾದ ಮನುಷ್ಯ ಇದ್ದಾನೆ — ಒಂದೇ ರಸ್ತೆಯ ಅಂಗಡಿಗೆ ಅದೇ ಅತಿ ವೇಗದ ದಾರಿ."
  },
