{
  "expo": {
    "name": "Kunigal Grocery",
    "slug": "kunigal-grocery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kunigalgrocery",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "in.kunigal.grocery",
      "buildNumber": "1"
    },
    "android": {
      "package": "in.kunigal.grocery",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E3F3EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": ["android.permission.ACCESS_BACKGROUND_LOCATION"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kunigal Grocery needs your photos so you can add a picture to a product on the shelf.",
          "cameraPermission": "Kunigal Grocery needs the camera so you can photograph a product on the shelf."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E7C4A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kunigal Grocery shares your location with the customer only while you are carrying their order, and stops the moment the delivery ends.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "kunigal",
          "project": "kunigal-grocery"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
