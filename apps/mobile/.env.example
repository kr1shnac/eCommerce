# Copy this file to `.env` in the same folder and fill in your own values.
#   Supabase dashboard -> your project -> Project Settings -> Data API
#
# NEVER put the service_role key here. This file is bundled into the app, so
# anyone can read it. service_role bypasses every Row Level Security policy.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY