# Copy this file to `.env` in the same folder and fill in your own values.
#   Supabase dashboard -> your project -> Project Settings -> API
#
# NEVER put the service_role / sb_secret_ key here. This file is bundled into
# the app, so anyone can read it. A secret key bypasses every RLS policy.
#
# The public key has two possible names; either works (see src/lib/supabase.ts):
#   publishable  ->  sb_publishable_...   (newer projects)
#   anon         ->  eyJhbGciOi...        (older projects)
# This file uses the publishable name; EXPO_PUBLIC_SUPABASE_ANON_KEY and
# EXPO_PUBLIC_SUPABASE_KEY are also accepted.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLIC-KEY

# ---------------------------------------------------------------------------
# Development-only demo sign-in (optional — delete this block and it vanishes)
# ---------------------------------------------------------------------------
# The app signs in with a phone number and a one-time code, which needs an SMS
# provider. Until one is configured there are no accounts, so nothing behind
# sign-in can be looked at. `supabase/demo-accounts.sql` creates a customer, a
# rider and a shop owner instead, and these lines are what make them appear as
# buttons on the login screen.
#
# Leave an address out and its button is simply not shown. The whole block is
# behind __DEV__, so it never appears in a real build even if the lines remain.
# The password is the one you passed to demo-accounts.sql with -v demo_password.
#
# EXPO_PUBLIC_DEMO_PASSWORD=
# EXPO_PUBLIC_DEMO_CUSTOMER_EMAIL=
# EXPO_PUBLIC_DEMO_DELIVERY_EMAIL=
# EXPO_PUBLIC_DEMO_ADMIN_EMAIL=