# Copy this file to `.env` in the same folder and fill in your own values.
#   Supabase dashboard -> your project -> Project Settings -> API
#
# The shop-owner panel is a Next.js app, so these variables are prefixed
# NEXT_PUBLIC_ and are compiled into the browser bundle — exactly like the
# mobile app's EXPO_PUBLIC_ lines, anyone who loads the page can read them.
#
# NEVER put the service_role / sb_secret_ key here. The panel signs in as a real
# user whose profiles.role is 'admin' and uses the publishable key, so RLS still
# applies. A secret key would turn the whole permission model off.
#
# The public key has two possible names; either works (see src/lib/supabase/env.ts):
#   publishable  ->  sb_publishable_...   (newer projects)
#   anon         ->  eyJhbGciOi...        (older projects)
# NEXT_PUBLIC_SUPABASE_KEY is also accepted, for dashboards that use that name.
# Set exactly one key variable.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLIC-KEY

# Optional: shown in the footer of the landing page.
# NEXT_PUBLIC_APP_VERSION=16
